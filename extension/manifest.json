{
  "manifest_version": 3,
  "name": "Booru Favorites Highlighter",
  "version": "1.0.0",
  "description": "Highlight, hide, or remove posts you've already favorited (and downloaded) on Gelbooru, Danbooru, and Rule34, using your offline archive.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "*://*.gelbooru.com/*",
    "*://danbooru.donmai.us/*",
    "*://*.rule34.xxx/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Booru Favorites Highlighter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.gelbooru.com/*",
        "*://danbooru.donmai.us/*",
        "*://*.rule34.xxx/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
